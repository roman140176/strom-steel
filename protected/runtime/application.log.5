    <!-- 2. Что было сделано -->
    <section class="svc-card">
      <div class="svc-card__head">
        <div class="svc-card__head-icon svc-card__head-icon--dark">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63"></path></svg>
