AddDefaultCharset utf-8

# Browser caching for static assets (Lighthouse: efficient cache policy)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType image/avif              "access plus 30 days"
    ExpiresByType image/gif               "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/x-icon            "access plus 30 days"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType application/font-woff   "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType text/javascript         "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine on

    # Убираем слеш в конце адреса
    # RewriteBase /
    # RewriteCond %{REQUEST_URI} .+/$ [NC]
    # RewriteRule ^(.+)(/)$ $1 [L,R=301]

    #RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
    #RewriteRule ^ /%1 [NC,L,R]

    #RewriteCond %{REQUEST_FILENAME}.html -f
    #RewriteRule ^ %{REQUEST_URI}.html [NC,L]

    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule .* http://%{HTTP_HOST}%1 [R=301,L,QSA]
    
    # Универсальный редирект с домена С www. на домен БEЗ www
    # при необходимости - раскомментировать:
    
    # RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

    # prevent httpd from serving dotfiles (.htaccess, .svn, .git, etc.)
    RedirectMatch 403 /\..*$

    # if a directory or a file exists, use it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # otherwise forward it to index.php
    RewriteRule . index.php
</IfModule>
